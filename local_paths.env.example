# 기계마다 다른 절대 경로. 이 파일을 local_paths.env 로 복사해 값을 채우세요 (local_paths.env 는 git 에 올라가지 않습니다).
# 같은 이름의 환경변수를 주면 그 값이 이깁니다. 따옴표 없이 절대 경로를 씁니다 (~ 와 $VAR 는 풀리지 않습니다).

# Isaac Lab 파이썬 (학습·평가·전처리)
PY=/path/to/anaconda3/envs/env_isaaclab/bin/python
# PyRoki 파이썬 (retarget_g1_pyroki.py)
PY_PYROKI=/path/to/anaconda3/envs/env_pyroki/bin/python
# GR00T-WholeBodyControl 저장소. SONIC 체크포인트를 <GR00T_ROOT>/sonic_v1_1/, sonic_release/ 에서 찾습니다.
GR00T_ROOT=/path/to/GR00T-WholeBodyControl
# pyroki 저장소. examples/retarget_helpers 를 씁니다.
PYROKI_ROOT=/path/to/pyroki
